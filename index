import { useEffect, useRef, useState } from "react";

/* ---------- level data ---------- */

const eq = (a, b) => a.length === b.length && a.every((v, i) => v === b[i]);

const tracks = [
  {
    kind: "singly",
    name: "Singly Linked List",
    levels: [
      {
        id: 1,
        title: "First Link",
        brief: "Push 9 onto the head of the list.",
        start: ["4", "8"],
        hint: "Insert at head.",
        check: (v) => eq(v, ["9", "4", "8"]),
      },
      {
        id: 2,
        title: "Tail End",
        brief: "Append 15: 4 → 8 → 15.",
        start: ["4", "8"],
        hint: "Insert at tail is O(n) — you must walk to the end.",
        check: (v) => eq(v, ["4", "8", "15"]),
      },
      {
        id: 3,
        title: "Splice It In",
        brief: "Insert 7 at index 1: 3 → 7 → 11 → 20.",
        start: ["3", "11", "20"],
        hint: "One hop from head, then rewire.",
        check: (v) => eq(v, ["3", "7", "11", "20"]),
      },
      {
        id: 4,
        title: "Unlink the Head",
        brief: "Remove the head. Target: 6 → 2.",
        start: ["19", "6", "2"],
        hint: "head = head.next — O(1).",
        check: (v) => eq(v, ["6", "2"]),
      },
      {
        id: 5,
        title: "Search & Destroy",
        brief: "Find 42, then delete it by value.",
        start: ["5", "42", "13", "8"],
        hint: "Search first, then delete by value.",
        check: (v, op) =>
          eq(v, ["5", "13", "8"]) && op?.kind === "delete" && op.value === "42",
      },
      {
        id: 6,
        title: "Full Sweep",
        brief: "Traverse the entire list.",
        start: ["1", "2", "3", "4", "5"],
        hint: "Traverse visits every node once.",
        check: (_v, op) => op?.kind === "traverse",
      },
    ],
  },
  {
    kind: "doubly",
    name: "Doubly Linked List",
    levels: [
      {
        id: 1,
        title: "Two-Way Street",
        brief: "Insert 5 at head of 8 ⇄ 12.",
        start: ["8", "12"],
        hint: "newNode.next = head; head.prev = newNode.",
        check: (v) => eq(v, ["5", "8", "12"]),
      },
      {
        id: 2,
        title: "Drop the Tail",
        brief: "Delete the tail. Target: 3 ⇄ 4.",
        start: ["3", "4", "77"],
        hint: "tail = tail.prev — O(1) with a tail pointer.",
        check: (v) => eq(v, ["3", "4"]),
      },
      {
        id: 3,
        title: "Middle Unlink",
        brief: "Delete 50 by value: 11 ⇄ 22 ⇄ 33.",
        start: ["11", "22", "50", "33"],
        hint: "prev.next = target.next; target.next.prev = prev.",
        check: (v, op) =>
          eq(v, ["11", "22", "33"]) && op?.kind === "delete" && op.value === "50",
      },
    ],
  },
  {
    kind: "circular",
    name: "Circular Linked List",
    levels: [
      {
        id: 1,
        title: "Close the Loop",
        brief: "Insert 3 at head — tail must still point back to it.",
        start: ["6", "9"],
        hint: "tail.next = head, always.",
        check: (v) => eq(v, ["3", "6", "9"]),
      },
      {
        id: 2,
        title: "Rotate the Ring",
        brief: "Make 2 the head: delete head, re-append 1 at tail.",
        start: ["1", "2", "3"],
        hint: "Delete head (1), then insert 1 at tail.",
        check: (v) => eq(v, ["2", "3", "1"]),
      },
    ],
  },
];

/* ---------- component ---------- */

let idCounter = 0;
const makeNode = (value) => ({ id: ++idCounter, value, state: "idle" });

const stateColor = {
  idle: "#333",
  visiting: "#e0a800",
  found: "#2ecc71",
  inserting: "#3498db",
  removing: "#e74c3c",
};

export default function LinkedListLab() {
  const [trackIdx, setTrackIdx] = useState(0);
  const [levelIdx, setLevelIdx] = useState(0);
  const track = tracks[trackIdx];
  const level = track.levels[levelIdx];

  const [nodes, setNodes] = useState(() => track.levels[0].start.map(makeNode));
  const [value, setValue] = useState("");
  const [index, setIndex] = useState("");
  const [busy, setBusy] = useState(false);
  const [cleared, setCleared] = useState(false);
  const [log, setLog] = useState([`Mission: ${level.title}`]);

  const nodesRef = useRef(nodes);
  useEffect(() => {
    nodesRef.current = nodes;
  }, [nodes]);

  const wait = (ms = 500) => new Promise((r) => setTimeout(r, ms));
  const addLog = (s) => setLog((l) => [s, ...l].slice(0, 30));
  const setNodeState = (id, state) =>
    setNodes((prev) => prev.map((n) => (n.id === id ? { ...n, state } : n)));
  const clearStates = () =>
    setNodes((prev) => prev.map((n) => ({ ...n, state: "idle" })));

  const loadLevel = (t, l) => {
    const lv = tracks[t].levels[l];
    setTrackIdx(t);
    setLevelIdx(l);
    setNodes(lv.start.map(makeNode));
    setCleared(false);
    setValue("");
    setIndex("");
    addLog(`Mission: ${lv.title}`);
  };

  const run = async (fn) => {
    if (busy || cleared) return;
    setBusy(true);
    clearStates();
    const op = await fn();
    setBusy(false);
    setTimeout(clearStates, 700);
    if (op) {
      setTimeout(() => {
        if (level.check(nodesRef.current.map((n) => n.value), op)) {
          setCleared(true);
          addLog(`✓ Mission cleared: ${level.title}`);
        }
      }, 60);
    }
  };

  const walkTo = async (i, list) => {
    for (let k = 0; k < Math.min(i, list.length); k++) {
      setNodeState(list[k].id, "visiting");
      await wait(350);
      setNodeState(list[k].id, "idle");
    }
  };

  const insertAt = (where) => async () => {
    const raw = value.trim();
    if (!raw) {
      addLog("Enter a value first.");
      return;
    }
    const list = nodes;
    const i = where === "head" ? 0 : where === "tail" ? list.length : Number(index);
    if (where === "at" && (!Number.isInteger(i) || i < 0 || i > list.length)) {
      addLog(`Index must be 0–${list.length}.`);
      return;
    }
    await walkTo(i, list);
    const node = { ...makeNode(raw), state: "inserting" };
    setNodes((prev) => {
      const next = [...prev];
      next.splice(i, 0, node);
      return next;
    });
    addLog(`insert(${raw}) at index ${i}`);
    await wait(400);
    setNodeState(node.id, "idle");
    setValue("");
    return { kind: "insert", value: raw, index: i };
  };

  const deleteAt = (where) => async () => {
    const list = nodes;
    if (!list.length) {
      addLog("List is empty.");
      return;
    }
    let i;
    if (where === "head") i = 0;
    else if (where === "tail") i = list.length - 1;
    else if (where === "at") {
      i = Number(index);
      if (!Number.isInteger(i) || i < 0 || i >= list.length) {
        addLog(`Index must be 0–${list.length - 1}.`);
        return;
      }
    } else {
      const raw = value.trim();
      i = list.findIndex((n) => n.value === raw);
      if (i === -1) {
        addLog(`${raw} not found.`);
        return;
      }
    }
    await walkTo(i, list);
    const target = list[i];
    setNodeState(target.id, "removing");
    addLog(`delete at index ${i}`);
    await wait(400);
    setNodes((prev) => prev.filter((n) => n.id !== target.id));
    return { kind: "delete", value: target.value, index: i };
  };

  const search = async () => {
    const raw = value.trim();
    if (!raw) {
      addLog("Enter a value to search.");
      return;
    }
    for (let i = 0; i < nodes.length; i++) {
      const n = nodes[i];
      setNodeState(n.id, "visiting");
      await wait(350);
      if (n.value === raw) {
        setNodeState(n.id, "found");
        addLog(`Found ${raw} at index ${i}.`);
        return { kind: "search", value: raw, index: i, found: true };
      }
      setNodeState(n.id, "idle");
    }
    addLog(`${raw} not found.`);
    return { kind: "search", value: raw, found: false };
  };

  const traverse = async () => {
    for (const n of nodes) {
      setNodeState(n.id, "visiting");
      await wait(300);
      setNodeState(n.id, "found");
    }
    addLog(`Traversed ${nodes.length} node(s).`);
    return { kind: "traverse" };
  };

  const btn = {
    padding: "6px 12px",
    borderRadius: 6,
    border: "1px solid #444",
    background: "#222",
    color: "#eee",
    cursor: "pointer",
  };
  const input = {
    padding: "6px 8px",
    borderRadius: 6,
    border: "1px solid #444",
    background: "#111",
    color: "#eee",
    width: 90,
  };

  return (
    <div
      style={{
        fontFamily: "monospace",
        color: "#eee",
        background: "#0d0d0d",
        padding: 24,
        borderRadius: 12,
      }}
    >
      <div style={{ display: "flex", gap: 8, marginBottom: 16, flexWrap: "wrap" }}>
        {tracks.map((t, i) => (
          <button
            key={t.kind}
            style={{
              ...btn,
              background: i === trackIdx ? "#2ecc71" : "#222",
              color: i === trackIdx ? "#000" : "#eee",
            }}
            onClick={() => loadLevel(i, 0)}
          >
            {t.name}
          </button>
        ))}
      </div>

      <p>
        Mission {level.id}/{track.levels.length} — <b>{level.title}</b>: {level.brief}
      </p>
      <p style={{ opacity: 0.6, fontSize: 12 }}>hint: {level.hint}</p>

      <div
        style={{
          display: "flex",
          alignItems: "center",
          gap: 6,
          minHeight: 70,
          margin: "16px 0",
          overflowX: "auto",
        }}
      >
        <span>head →</span>
        {nodes.map((n) => (
          <div
            key={n.id}
            style={{
              border: `2px solid ${stateColor[n.state]}`,
              borderRadius: 8,
              padding: "10px 14px",
              minWidth: 40,
              textAlign: "center",
            }}
          >
            {n.value}
          </div>
        ))}
        <span>→ {track.kind === "circular" ? "head" : "null"}</span>
      </div>

      {cleared && (
        <div style={{ marginBottom: 12 }}>
          <b>Mission cleared!</b>{" "}
          <button
            style={btn}
            onClick={() =>
              levelIdx + 1 < track.levels.length
                ? loadLevel(trackIdx, levelIdx + 1)
                : loadLevel((trackIdx + 1) % tracks.length, 0)
            }
          >
            next →
          </button>
        </div>
      )}

      <div style={{ display: "flex", gap: 8, marginBottom: 12 }}>
        <input
          style={input}
          placeholder="value"
          value={value}
          onChange={(e) => setValue(e.target.value)}
        />
        <input
          style={input}
          placeholder="index"
          value={index}
          onChange={(e) => setIndex(e.target.value)}
        />
      </div>

      <div style={{ display: "flex", gap: 6, flexWrap: "wrap" }}>
        <button style={btn} disabled={busy} onClick={() => run(insertAt("head"))}>
          insert head
        </button>
        <button style={btn} disabled={busy} onClick={() => run(insertAt("tail"))}>
          insert tail
        </button>
        <button style={btn} disabled={busy} onClick={() => run(insertAt("at"))}>
          insert at
        </button>
        <button style={btn} disabled={busy} onClick={() => run(deleteAt("head"))}>
          delete head
        </button>
        <button style={btn} disabled={busy} onClick={() => run(deleteAt("tail"))}>
          delete tail
        </button>
        <button style={btn} disabled={busy} onClick={() => run(deleteAt("at"))}>
          delete at
        </button>
        <button style={btn} disabled={busy} onClick={() => run(deleteAt("value"))}>
          delete value
        </button>
        <button style={btn} disabled={busy} onClick={() => run(search)}>
          search
        </button>
        <button style={btn} disabled={busy} onClick={() => run(traverse)}>
          traverse
        </button>
        <button style={btn} onClick={() => loadLevel(trackIdx, levelIdx)}>
          restart
        </button>
      </div>

      <ul style={{ marginTop: 16, fontSize: 12, opacity: 0.8, maxHeight: 160, overflowY: "auto" }}>
        {log.map((l, i) => (
          <li key={i}>{l}</li>
        ))}
      </ul>
    </div>
  );
}

